# Copy this to .env for local development (never commit .env!)

# Flask environment: development | production
FLASK_ENV=development

# Strong random secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-super-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database (leave blank to use SQLite locally)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated list of allowed frontend origins (for CORS)
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173
